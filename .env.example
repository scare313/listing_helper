# Gemini API (get free key at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Amazon SP-API (optional for now)
AMAZON_SP_API_REFRESH_TOKEN=
AMAZON_SP_API_CLIENT_ID=
AMAZON_SP_API_CLIENT_SECRET=
AMAZON_MARKETPLACE_ID=A21TJRUUN4KGV

# Flipkart API (optional for now)
FLIPKART_APP_ID=
FLIPKART_APP_SECRET=

# App Settings
APP_HOST=127.0.0.1
APP_PORT=8000
DATABASE_PATH=data/listing_helper.db
EXPORT_PATH=data/exports
UPLOAD_PATH=data/uploads
DEFAULT_TARGET_MARGIN=25

# Browser Scraping Settings (False = visible browser window)
HEADLESS_BROWSER=True
SCRAPER_MIN_DELAY=2
SCRAPER_MAX_DELAY=4
SCRAPER_MAX_RETRIES=2
